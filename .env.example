# 管理员密码（必填，用于登录后台配置面板）
ADMIN_PASSWORD=your_password_here

# token 签名密钥（必填，勿与 ADMIN_PASSWORD 相同；可用 `openssl rand -hex 32` 生成）
ADMIN_SECRET=your_admin_secret_here

# 服务端口（可选，默认 3000）
PORT=3000

# 高德地图 JS API Key（在 https://console.amap.com 控制台创建「Web端(JS API)」类型 key）
AMAP_KEY=your_amap_key_here

# 高德地图安全密钥（jscode）——控制台「应用管理 → 安全密钥」查看，配合 key 白名单使用
AMAP_SECURITY_CODE=your_amap_security_code_here

# 和风天气 QWeather（可选，用于首页天气组件；新版需专属 API Host）
# QWEATHER_KEY=your_qweather_key_here
# QWEATHER_HOST=https://xxx.qweatherapi.com

# 数据库文件路径（可选，默认 ./data/exhibition-nav.db）
# DB_PATH=./data/exhibition-nav.db
